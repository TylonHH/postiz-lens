# Copy to .env and fill in. Never commit .env.

# Postiz Cloud:      https://api.postiz.com
# Self-hosted:       https://your-domain/api
POSTIZ_API_URL=https://api.postiz.com

# Postiz -> Settings -> Developers -> API key
POSTIZ_API_KEY=

# Folders that contain your source videos/images (separated by ";" on Windows, ":" on macOS/Linux).
# Subfolders are scanned. Leave empty to skip the local-file features.
LOCAL_MEDIA_DIRS=

# Optional
# PORT=4747
# HOST=127.0.0.1
# DB_PATH=./data/lens.db
# SYNC_INTERVAL_MIN=60      # how often posts and stats are refreshed
# SYNC_FROM_DAYS=365        # how far back to look for posts
# SYNC_AHEAD_DAYS=120       # how far ahead to look for scheduled posts
# MAX_STATS_PER_SYNC=80     # cap on post-analytics calls per sync
